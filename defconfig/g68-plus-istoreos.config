# =============================================================================
#  iStoreOS 风格附加配置  —  追加在 defconfig/g68-plus-docker.config 之后
#
#  目标: rockchip / armv8 / DEVICE_nsy_g68-plus
#        (NSY G68-PLUS, RK3568, aarch64_generic, Linux 6.6)
#
#  用法:  cat defconfig/g68-plus-istoreos.config >> .config && make defconfig
#  说明:  这里只写"差异项"; 依赖(etherwake / webdav2 / luci-lib-taskd ...)
#         由 make defconfig 自动补齐。未安装或已废弃的符号会被静默丢弃,
#         由 CI 的 "校验附加包是否生效" 步骤汇总报告。
# =============================================================================

# ---------------------------------------------------------------------------
# 1. iStoreOS 风格: 快速配置(quickstart) + 应用商店(istore)
#    quickstart     : 向导式初始化 / 磁盘管理, 预编译包, 仅 aarch64|arm|x86_64
#    luci-app-store : iStore 应用商店, 依赖 taskd + luci-lib-taskd + luci-lib-xterm
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y

# ---------------------------------------------------------------------------
# 2. 文件共享 / 运维面板
#    unishare : 统一共享面板(samba4 + webdav2 聚合管理)
#    lucky    : 反向代理 / DDNS / 内网穿透 / WOL 一体的运维面板
#    wolplus  : 网络唤醒增强
#    rtbwmon  : 实时流量监控
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_unishare=y
CONFIG_PACKAGE_luci-app-unishare=y
CONFIG_PACKAGE_webdav2=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-wolplus=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-rtbwmon=y

# ---------------------------------------------------------------------------
# 3. 文件管理
#    luci-app-filemanager  : 官方 luci feed 内置 (24.10 分支为 JS 前端)
#    luci-app-filetransfer : 第三方单包仓库, 由 workflow 克隆到 package/ 下
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-filetransfer=y

# ---------------------------------------------------------------------------
# 4. Samba4 (含 LuCI Web 管理)
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-samba4=y

# ---------------------------------------------------------------------------
# 5. Docker 引擎
#    原 defconfig 只选了 luci-app-dockerman / luci-lib-docker (界面),
#    没有 dockerd / containerd / runc / docker (引擎本体), 这里补齐,
#    与文件名 g68-plus-docker.config 的本意一致。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_DOCKER_STO_EXT4=y
CONFIG_DOCKER_NET_MACVLAN=y

# ---------------------------------------------------------------------------
# 5b. shadowsocks-rust (保持启用)
#     由基础 defconfig 选中, 保留即可用 ss 客户端/服务端。
#     注意: 它会作为构建依赖拉起 lang/rust (rustc + LLVM 源码编译), 每次全新构建
#     多花约 2 小时 (整体 ~4 小时)。确实不需要时可在此显式关闭:
#       # CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
#       # CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
#     (workflow 里有强制关闭 pass, 能保证 is not set 不被 kconfig 翻回 =y)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 5c. 存储 / 共享 / 管控 / 监控 扩展 (2026-11-07 新增)
#     说明:
#       * appfilter / nlbwmon / smartmontools / unishare 基础配置或本文件已包含, 不重复写
#       * nlbwmon 后端已 =y, 这里只补 LuCI 界面
#       * SMART 没有独立的 luci-app-smartmontools, 用 luci-app-diskman 的 SMART 页签
#       * mergerfs 在 immortalwrt 24.10 / small-package 里都没有, 无法集成
# ---------------------------------------------------------------------------
# 流量监控 / 限速 / 上网管控
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-eqosplus=y
CONFIG_PACKAGE_luci-app-timecontrol=y
CONFIG_PACKAGE_luci-app-control-webrestriction=y
CONFIG_PACKAGE_luci-app-control-weburl=y

# 共享 / 文件系统
CONFIG_PACKAGE_luci-app-nfs=y
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_luci-app-cifs-mount=y
CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_cifsmount=y

# 分区工具：交互式分区（cfdisk/MBR, cgdisk=GPT）
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_cgdisk=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_sfdisk=y

# 菜单排序（独立仓库 luci-app-menusort）
CONFIG_PACKAGE_luci-app-menusort=y

# 分区管理: luci-app-partexp（一键格式化/扩容/挂载, 源码来自 sirpdboy/luci-app-partexp）
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_f2fs-tools=y

# DDNS: 经典 ddns-scripts(luci-app-ddns) + Go 版 ddns-go(luci-app-ddns-go)
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
# 注: dnspod.cn(国内站) 的 provider 已内置在 ddns-scripts 里(update_dnspod_cn*.sh),
#     无需额外包; dnspod.com(国际站) 需 ddns-scripts-dnspod-com, 该符号不在当前 feeds, 故不选
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
# 中文语言包(显式选中, 不依赖语言菜单联动)
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y

# 外接盘/NVMe 文件系统支持(自动挂载脚本会用到)
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

# 磁盘管理(SMART 图形界面)
CONFIG_PACKAGE_luci-app-diskman=y

# Home Assistant (Docker 方式: 界面 + 编排, 镜像首次启动时拉取)
CONFIG_PACKAGE_luci-app-homeassistant=y
CONFIG_PACKAGE_luci-i18n-homeassistant-zh-cn=y

# ---------------------------------------------------------------------------
# 6. 系统 / 构建参数
#    rootfs 分区加大 (MB), 便于 docker 镜像与商店安装;
#    workflow 的 rootfs_size 输入会覆盖此值。
#    ccache 缓存目录为本树 .ccache (rules.mk: TOPDIR/.ccache), CI 会缓存它。
# ---------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_CCACHE=y

# Argon 主题配置（提供「系统 → Argon 主题设置」：颜色/模糊/在线壁纸源，含必应每日壁纸）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
